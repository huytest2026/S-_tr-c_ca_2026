function getGivenName(fullName) {
  if (!fullName) return '';
  const parts = fullName.toString().trim().split(/\s+/);
  return parts[parts.length - 1];
}

function getPdfUrlFromDocUrl(docUrl) {
  if (!docUrl) return '';
  const match = docUrl.match(/\/d\/([a-zA-Z0-9-_]+)/);
  if (match && match[1]) {
    return `https://docs.google.com/document/d/${match[1]}/export?format=pdf`;
  }
  return '';
}

function toCanonicalDate(val) {
  if (!val) return '';
  if (val instanceof Date) {
    const y = val.getFullYear();
    const m = String(val.getMonth() + 1).padStart(2, '0');
    const d = String(val.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  }
  const str = val.toString().trim();
  if (str.includes('-')) {
    const parts = str.split('T')[0].split('-');
    if (parts.length === 3 && parts[0].length === 4) {
      return `${parts[0]}-${parts[1].padStart(2, '0')}-${parts[2].padStart(2, '0')}`;
    }
  }
  if (str.includes('/')) {
    const parts = str.split('/');
    if (parts.length === 3 && parts[2].length === 4) {
      return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
    }
  }
  return str;
}

function formatDate(dateStr) {
  const canonical = toCanonicalDate(dateStr);
  if (!canonical || !canonical.includes('-')) return dateStr;
  const parts = canonical.split('-');
  return `${parts[2]}/${parts[1]}/${parts[0]}`;
}

function getContentFromLastDoc(docUrl) {
  let content = { congViecThuongXuyen: '', noiDungCongViec: '', noiDungTonTai: '' };
  if (!docUrl || !docUrl.includes('http')) return content;
  try {
    const doc = DocumentApp.openByUrl(docUrl);
    const text = doc.getBody().getText();
    const idx21 = text.indexOf("2.1. Bảo dưỡng ngày");
    const idx22 = text.indexOf("2.2. Tình hình thông tin");
    const idx24 = text.indexOf("2.4. TỒN TẠI");
    const idx3 = text.indexOf("3. XÁC NHẬN BÀN GIAO");

    if (idx21 !== -1 && idx22 !== -1) content.congViecThuongXuyen = text.substring(idx21 + "2.1. Bảo dưỡng ngày".length, idx22).trim();
    if (idx22 !== -1 && idx24 !== -1) content.noiDungCongViec = text.substring(idx22 + "2.2. Tình hình thông tin".length, idx24).trim();
    if (idx24 !== -1 && idx3 !== -1) content.noiDungTonTai = text.substring(idx24 + "2.4. TỒN TẠI".length, idx3).trim();
  } catch (e) {
    Logger.log("Lỗi đọc Doc: " + e.toString());
  }
  return content;
}

function getShiftData(dateStr, caTruc) {
  try {
    const targetCanonicalDate = toCanonicalDate(dateStr);
    const targetCa = caTruc ? caTruc.toString().trim().toLowerCase() : '';
    const ss = SpreadsheetApp.openById(LOG_SHEET_ID);
    const sheet = ss.getSheets()[0];
    const lastRow = sheet.getLastRow();
    
    if (lastRow < 2) return { success: true, found: false, message: 'Chưa có dữ liệu nhật ký ca trực.' };

    const displayValues = sheet.getRange(2, 1, lastRow - 1, sheet.getLastColumn()).getDisplayValues();
    const rawValues = sheet.getRange(2, 1, lastRow - 1, sheet.getLastColumn()).getValues();

    for (let i = displayValues.length - 1; i >= 0; i--) {
      const displayRow = displayValues[i];
      const rawRow = rawValues[i];
      const rowDateCanonical = toCanonicalDate(displayRow[1]) || toCanonicalDate(rawRow[1]);
      const rowCa = displayRow[2] ? displayRow[2].toString().trim().toLowerCase() : '';

      if (rowDateCanonical === targetCanonicalDate && rowCa === targetCa) {
        const docUrl = rawRow.find(val => typeof val === 'string' && val.includes('docs.google.com/document')) ||
                       displayRow.find(val => typeof val === 'string' && val.includes('docs.google.com/document'));
        let content = docUrl ? getContentFromLastDoc(docUrl) : {
          congViecThuongXuyen: displayRow[5] || '',
          noiDungCongViec: displayRow[6] || '',
          noiDungTonTai: displayRow[7] || ''
        };

        return {
          success: true,
          found: true,
          data: {
            nguoiGiao: displayRow[3] || rawRow[3] || '',
            nguoiNhan: displayRow[4] || rawRow[4] || '',
            congViecThuongXuyen: content.congViecThuongXuyen,
            noiDungCongViec: content.noiDungCongViec,
            noiDungTonTai: content.noiDungTonTai,
            docUrl: docUrl || '',
            pdfUrl: getPdfUrlFromDocUrl(docUrl)
          }
        };
      }
    }
    return { success: true, found: false, message: `Không tìm thấy dữ liệu của ${caTruc} ngày ${formatDate(dateStr)}.` };
  } catch (err) {
    return { success: false, error: err.toString() };
  }
}

function getInitialData() {
  try {
    const ss = SpreadsheetApp.openById(LOG_SHEET_ID);
    
    const staffSheet = ss.getSheetByName('Danh sách nhân viên') || ss.getSheets()[1];
    let staffList = [];
    const lastStaffRow = staffSheet.getLastRow();
    
    if (lastStaffRow >= 2) {
      const values = staffSheet.getRange(2, 2, lastStaffRow - 1, 1).getValues();
      staffList = values.map(row => row[0]).filter(name => name && name.toString().trim() !== '')
        .sort((a, b) => getGivenName(a).localeCompare(getGivenName(b), 'vi'));
    }

    const shSheet = ss.getSheetByName('Số hóa tuyến cáp') || ss.getSheetByName('Số hóa cáp quang');
    let linkSet = {};
    let tuyenCapSet = {};

    if (shSheet) {
      const shLastRow = shSheet.getLastRow();
      if (shLastRow >= 2) {
        const shValues = shSheet.getRange(2, 1, shLastRow - 1, Math.max(4, shSheet.getLastColumn())).getDisplayValues();
        shValues.forEach(row => {
          const tuyenCap = row[2] ? row[2].toString().trim() : '';
          const link = row[3] ? row[3].toString().trim() : '';
          if (tuyenCap) tuyenCapSet[tuyenCap] = true;
          if (link) linkSet[link] = true;
        });
      }
    }

    const linkList = Object.keys(linkSet).sort();
    const tuyenCapList = Object.keys(tuyenCapSet).sort();

    const vtSheet = ss.getSheetByName('VẬT TƯ VT') || ss.getSheetByName('THEO DÕI VẬT TƯ');
    let linhVucSet = {};
    let allVatTuData = [];

    if (vtSheet) {
      const vtLastRow = vtSheet.getLastRow();
      if (vtLastRow >= 2) {
        const vtValues = vtSheet.getDataRange().getDisplayValues();
        const headers = vtValues[0];
        
        let colMap = {};
        for (let j = 0; j < headers.length; j++) {
          colMap[headers[j].toString().trim().toUpperCase()] = j;
        }

        for (let i = 1; i < vtValues.length; i++) {
          const row = vtValues[i];
          const lv = colMap['LINHVUC'] !== undefined ? row[colMap['LINHVUC']].toString().trim() : '';
          const tt = colMap['TENTAT'] !== undefined ? row[colMap['TENTAT']].toString().trim() : '';
          
          if (lv) linhVucSet[lv] = true;

          allVatTuData.push({
            maKho: colMap['MA_KHO'] !== undefined ? row[colMap['MA_KHO']] : (colMap['MALDAKHO'] !== undefined ? row[colMap['MALDAKHO']] : ''),
            tenKho: colMap['TEN_KHO'] !== undefined ? row[colMap['TEN_KHO']] : (colMap['TENLDAKHO'] !== undefined ? row[colMap['TENLDAKHO']] : ''),
            loHang: colMap['LOHANG'] !== undefined ? row[colMap['LOHANG']] : '',
            maVt: colMap['MA_VT'] !== undefined ? row[colMap['MA_VT']] : '',
            tenVt: colMap['TEN_VT'] !== undefined ? row[colMap['TEN_VT']] : (colMap['TENVT'] !== undefined ? row[colMap['TENVT']] : ''),
            tenTat: tt,
            partNumber: colMap['PART_NUMBER'] !== undefined ? row[colMap['PART_NUMBER']] : '',
            serial: colMap['SERIAL'] !== undefined ? row[colMap['SERIAL']] : '',
            linhVuc: lv
          });
        }
      }
    }
    const linhVucList = Object.keys(linhVucSet).sort((a, b) => a.localeCompare(b, 'vi'));

    const logSheet = ss.getSheets()[0];
    const lastLogRow = logSheet.getLastRow();
    let lastHandover = { congViecThuongXuyen: '', noiDungCongViec: '', noiDungTonTai: '', pdfUrl: '' };

    if (lastLogRow >= 2) {
      const rowValues = logSheet.getRange(lastLogRow, 1, 1, logSheet.getLastColumn()).getValues()[0];
      const docUrl = rowValues.find(val => typeof val === 'string' && val.includes('docs.google.com/document'));
      if (docUrl) {
        lastHandover = getContentFromLastDoc(docUrl);
        lastHandover.pdfUrl = getPdfUrlFromDocUrl(docUrl);
      }
    }

    return { 
      success: true, 
      staffList: staffList, 
      linkList: linkList, 
      tuyenCapList: tuyenCapList, 
      linhVucList: linhVucList,
      allVatTuData: allVatTuData,
      lastHandover: lastHandover 
    };
  } catch (err) {
    return { success: false, error: err.toString() };
  }
}

function processHandover(formData) {
  try {
    const templateFile = DriveApp.getFileById(TEMPLATE_DOC_ID);
    const targetFolder = DriveApp.getFolderById(STORAGE_FOLDER_ID);
    const formattedDate = formatDate(formData.ngayGiao);
    const fileName = `Sổ Giao Ca - ${formData.caTruc} - ${formattedDate}`;
    
    const newFile = templateFile.makeCopy(fileName, targetFolder);
    const doc = DocumentApp.openById(newFile.getId());
    const body = doc.getBody();
    
    body.replaceText('{{NGAY_GIAO}}', formattedDate);
    body.replaceText('{{CA_TRUC}}', formData.caTruc || '');
    body.replaceText('{{CONG_VIEC_THUONG_XUYEN}}', formData.congViecThuongXuyen || 'Không có');
    body.replaceText('{{NOI_DUNG_CONG_VIEC}}', formData.noiDungCongViec || 'Bình thường');
    body.replaceText('{{NOI_DUNG_TON_TAI}}', formData.noiDungTonTai || 'Không có');
    body.replaceText('{{NGUOI_GIAO}}', formData.nguoiGiao || '');
    body.replaceText('{{NGUOI_NHAN}}', formData.nguoiNhan || '');
    doc.saveAndClose();
    
    const docUrl = newFile.getUrl();
    const pdfUrl = getPdfUrlFromDocUrl(docUrl);
    
    const sheet = SpreadsheetApp.openById(LOG_SHEET_ID).getSheets()[0];
    sheet.appendRow([new Date(), formattedDate, formData.caTruc, formData.nguoiGiao, formData.nguoiNhan, docUrl]);
    
    return { success: true, url: docUrl, pdfUrl: pdfUrl };
  } catch (err) {
    return { success: false, error: err.toString() };
  }
}

function searchSuCo(linkVal, tuyenCapVal, otdrVal, onlyNearest) {
  try {
    const ss = SpreadsheetApp.openById(LOG_SHEET_ID);
    const sheet = ss.getSheetByName('Sự cố cáp quang');
    
    if (!sheet) {
      return { success: false, error: 'Không tìm thấy sheet "Sự cố cáp quang".' };
    }
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return { success: true, data: [] };

    const values = sheet.getRange(2, 1, lastRow - 1, 11).getDisplayValues();
    let results = [];
    const searchOtdr = parseFloat(otdrVal);

    values.forEach(row => {
      const id = row[0];
      const tramQL = row[1];
      const tuyenCap = row[2] ? row[2].toString().trim() : '';
      const link = row[3] ? row[3].toString().trim() : '';
      const doiTuong = row[4];
      const otdr = row[5];
      const taiKm = row[6];
      const toaDo = row[7];
      const thoiGian = row[8];
      const mxPs = row[9];
      const mCapPs = row[10] || '';

      let match = true;
      if (linkVal && linkVal.trim() !== "" && link !== linkVal.trim()) match = false;
      if (tuyenCapVal && tuyenCapVal.trim() !== "" && tuyenCap !== tuyenCapVal.trim()) match = false;

      if (match) {
        let diff = 999999;
        if (!isNaN(searchOtdr) && otdr) {
          const numOtdr = parseFloat(otdr.toString().replace(',', '.'));
          if (!isNaN(numOtdr)) diff = Math.abs(numOtdr - searchOtdr);
        }
        results.push({ id, tramQL, tuyenCap, link, doiTuong, otdr, taiKm, toaDo, thoiGian, mxPs, mCapPs, diff });
      }
    });

    if (!isNaN(searchOtdr) && results.length > 0) {
      results.sort((a, b) => a.diff - b.diff);
    }

    if (onlyNearest && results.length > 0) {
      results = [results[0]];
    }

    return { success: true, data: results };
  } catch (err) {
    return { success: false, error: err.toString() };
  }
}

function searchSoHoa(linkVal, tuyenCapVal, keywordVal) {
  try {
    const ss = SpreadsheetApp.openById(LOG_SHEET_ID);
    const sheet = ss.getSheetByName('Số hóa tuyến cáp') || ss.getSheetByName('Số hóa cáp quang');
    
    if (!sheet) {
      return { success: false, error: 'Không tìm thấy sheet "Số hóa tuyến cáp".' };
    }
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return { success: true, data: [] };

    const values = sheet.getRange(2, 1, lastRow - 1, Math.max(12, sheet.getLastColumn())).getDisplayValues();
    let results = [];

    values.forEach(row => {
      const id = row[0] || '';
      const tramQL = row[1] || '';
      const tuyenCap = row[2] ? row[2].toString().trim() : '';
      const link = row[3] ? row[3].toString().trim() : '';
      const doiTuong = row[4] || '';
      const otdr = row[5] || '';
      const doSau = row[6] || '';
      const taiKm = row[7] || '';
      const toaDo = row[8] || '';
      const thoiGian = row[9] || '';
      const dienGiai = row[11] || '';

      let match = true;
      if (linkVal && linkVal.trim() !== "" && link !== linkVal.trim()) match = false;
      if (tuyenCapVal && tuyenCapVal.trim() !== "" && tuyenCap !== tuyenCapVal.trim()) match = false;
      
      if (keywordVal && keywordVal.trim() !== "") {
        const kw = keywordVal.toLowerCase().trim();
        const combinedText = `${doiTuong} ${taiKm} ${dienGiai} ${tramQL}`.toLowerCase();
        if (!combinedText.includes(kw)) match = false;
      }

      if (match) {
        results.push({ id, tramQL, tuyenCap, link, doiTuong, otdr, doSau, taiKm, toaDo, thoiGian, dienGiai });
      }
    });

    return { success: true, data: results };
  } catch (err) {
    return { success: false, error: err.toString() };
  }
}

function searchVatTu(linhVucVal, tentatVal) {
  try {
    const ss = SpreadsheetApp.openById(LOG_SHEET_ID);
    const sheet = ss.getSheetByName('VẬT TƯ VT') || ss.getSheetByName('THEO DÕI VẬT TƯ');
    
    if (!sheet) {
      return { success: false, error: 'Không tìm thấy sheet "VẬT TƯ VT".' };
    }
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return { success: true, data: [] };

    const values = sheet.getDataRange().getDisplayValues();
    const headers = values[0];
    
    let colMap = {};
    for (let j = 0; j < headers.length; j++) {
      colMap[headers[j].toString().trim().toUpperCase()] = j;
    }

    let results = [];
    for (let i = 1; i < values.length; i++) {
      const row = values[i];
      const linhVuc = colMap['LINHVUC'] !== undefined ? row[colMap['LINHVUC']].toString().trim() : '';
      const tentat = colMap['TENTAT'] !== undefined ? row[colMap['TENTAT']].toString().trim() : '';

      if (!linhVucVal || linhVuc !== linhVucVal.trim()) {
        continue;
      }

      if (tentatVal && tentatVal.trim() !== '') {
        const kw = tentatVal.toLowerCase().trim();
        if (!tentat.toLowerCase().includes(kw)) {
          continue;
        }
      }

      results.push({
        maKho: colMap['MA_KHO'] !== undefined ? row[colMap['MA_KHO']] : (colMap['MALDAKHO'] !== undefined ? row[colMap['MALDAKHO']] : ''),
        tenKho: colMap['TEN_KHO'] !== undefined ? row[colMap['TEN_KHO']] : (colMap['TENLDAKHO'] !== undefined ? row[colMap['TENLDAKHO']] : ''),
        loHang: colMap['LOHANG'] !== undefined ? row[colMap['LOHANG']] : '',
        maVt: colMap['MA_VT'] !== undefined ? row[colMap['MA_VT']] : '',
        tenVt: colMap['TEN_VT'] !== undefined ? row[colMap['TEN_VT']] : (colMap['TENVT'] !== undefined ? row[colMap['TENVT']] : ''),
        tenTat: tentat,
        partNumber: colMap['PART_NUMBER'] !== undefined ? row[colMap['PART_NUMBER']] : '',
        serial: colMap['SERIAL'] !== undefined ? row[colMap['SERIAL']] : '',
        linhVuc: linhVuc
      });
    }

    return { success: true, data: results };
  } catch (err) {
    return { success: false, error: err.toString() };
  }
}
